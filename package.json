{
  "name": "ushiroe",
  "displayName": "UshiroE",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "otoneko1102",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/UshiroE.git"
  },
  "bugs": {
    "url": "https://github.com/otnc/UshiroE/issues"
  },
  "homepage": "https://github.com/otnc/UshiroE#readme",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "background",
    "background image",
    "wallpaper",
    "backimage",
    "背景"
  ],
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run build -- --production",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "npm run build && tsc -p tsconfig.integration.json && vscode-test",
    "package": "vsce package",
    "icons": "node scripts/icons.mjs",
    "docs:build": "kiritan build",
    "docs:check": "kiritan check"
  },
  "dependencies": {
    "@vscode/sudo-prompt": "^9.3.2",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.0",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "~1.100.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "dfh": "^0.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "kiritan": "^0.7.1",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "ushiroe.enable",
        "title": "%command.enable%",
        "category": "UshiroE",
        "icon": "$(eye)"
      },
      {
        "command": "ushiroe.disable",
        "title": "%command.disable%",
        "category": "UshiroE",
        "icon": "$(eye-closed)"
      },
      {
        "command": "ushiroe.toggle",
        "title": "%command.toggle%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.nextImage",
        "title": "%command.nextImage%",
        "category": "UshiroE",
        "icon": "$(arrow-right)"
      },
      {
        "command": "ushiroe.addImageFile",
        "title": "%command.addImageFile%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.addImageFolder",
        "title": "%command.addImageFolder%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.addImageUrl",
        "title": "%command.addImageUrl%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.repairPatch",
        "title": "%command.repairPatch%",
        "category": "UshiroE",
        "icon": "$(tools)"
      },
      {
        "command": "ushiroe.removePatch",
        "title": "%command.removePatch%",
        "category": "UshiroE",
        "icon": "$(discard)"
      },
      {
        "command": "ushiroe.importBackImage",
        "title": "%command.importBackImage%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.exportSettings",
        "title": "%command.exportSettings%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.importSettings",
        "title": "%command.importSettings%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.openSettings",
        "title": "%command.openSettings%",
        "category": "UshiroE",
        "icon": "$(gear)"
      },
      {
        "command": "ushiroe.refreshImages",
        "title": "%command.refreshImages%",
        "category": "UshiroE",
        "icon": "$(sync)"
      },
      {
        "command": "ushiroe.refreshSource",
        "title": "%command.refreshSource%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.openLibrary",
        "title": "%command.openLibrary%",
        "category": "UshiroE",
        "icon": "$(folder-opened)"
      },
      {
        "command": "ushiroe.chooseLibraryFolder",
        "title": "%command.chooseLibraryFolder%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.resetLibraryFolder",
        "title": "%command.resetLibraryFolder%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.savePreset",
        "title": "%command.savePreset%",
        "category": "UshiroE",
        "icon": "$(save)"
      },
      {
        "command": "ushiroe.applyPreset",
        "title": "%command.applyPreset%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.deletePreset",
        "title": "%command.deletePreset%",
        "category": "UshiroE"
      },
      {
        "command": "ushiroe.randomPreset",
        "title": "%command.randomPreset%",
        "category": "UshiroE",
        "icon": "$(debug-restart)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ushiroe",
          "title": "UshiroE",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "ushiroe": [
        {
          "id": "ushiroe.panel",
          "type": "webview",
          "name": "%view.panel%",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ushiroe.nextImage",
          "group": "navigation@1",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.openSettings",
          "group": "navigation@2",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.repairPatch",
          "group": "1_patch@1",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.removePatch",
          "group": "1_patch@2",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.importBackImage",
          "group": "2_transfer@1",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.importSettings",
          "group": "2_transfer@2",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.exportSettings",
          "group": "2_transfer@3",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.randomPreset",
          "group": "3_random@1",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.savePreset",
          "group": "3_random@2",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.refreshImages",
          "group": "4_library@1",
          "when": "view == ushiroe.panel"
        },
        {
          "command": "ushiroe.openLibrary",
          "group": "4_library@2",
          "when": "view == ushiroe.panel"
        }
      ],
      "commandPalette": [
        {
          "command": "ushiroe.refreshSource",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "UshiroE",
      "properties": {
        "ushiroe.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 0,
          "markdownDescription": "%config.enabled%"
        },
        "ushiroe.mode": {
          "type": "string",
          "enum": [
            "fullscreen",
            "parts"
          ],
          "enumDescriptions": [
            "%config.mode.fullscreen%",
            "%config.mode.parts%"
          ],
          "default": "fullscreen",
          "scope": "application",
          "order": 1,
          "markdownDescription": "%config.mode%"
        },
        "ushiroe.sources": {
          "type": "array",
          "default": [],
          "scope": "application",
          "order": 2,
          "markdownDescription": "%config.sources%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "%config.source.id%"
              },
              "name": {
                "type": "string",
                "description": "%config.source.name%"
              },
              "type": {
                "type": "string",
                "enum": [
                  "file",
                  "folder",
                  "url"
                ],
                "description": "%config.source.type%"
              },
              "path": {
                "type": "string",
                "description": "%config.source.path%"
              },
              "description": {
                "type": "string",
                "description": "%config.source.description%"
              },
              "random": {
                "type": "boolean",
                "default": false,
                "description": "%config.source.random%"
              },
              "interval": {
                "type": "number",
                "default": 10,
                "minimum": 0,
                "description": "%config.source.interval%"
              },
              "recursive": {
                "type": "boolean",
                "default": false,
                "description": "%config.source.recursive%"
              },
              "refresh": {
                "type": "string",
                "enum": [
                  "never",
                  "startup"
                ],
                "enumDescriptions": [
                  "%config.source.refresh.never%",
                  "%config.source.refresh.startup%"
                ],
                "default": "never",
                "description": "%config.source.refresh%"
              }
            }
          }
        },
        "ushiroe.fullscreen": {
          "type": "object",
          "scope": "application",
          "order": 3,
          "markdownDescription": "%config.fullscreen%",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "%config.area.source%"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "%config.area.opacity%"
            },
            "size": {
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "auto",
                "stretch",
                "tile"
              ],
              "description": "%config.area.size%"
            },
            "position": {
              "type": "string",
              "description": "%config.area.position%"
            },
            "blur": {
              "type": "number",
              "minimum": 0,
              "description": "%config.area.blur%"
            }
          },
          "default": {
            "source": null,
            "opacity": 0.15,
            "size": "cover",
            "position": "center",
            "blur": 0
          }
        },
        "ushiroe.editor": {
          "type": "object",
          "scope": "application",
          "order": 4,
          "markdownDescription": "%config.editor%",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "%config.area.enabled%"
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "%config.area.source%"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "%config.area.opacity%"
            },
            "size": {
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "auto",
                "stretch",
                "tile"
              ],
              "description": "%config.area.size%"
            },
            "position": {
              "type": "string",
              "description": "%config.area.position%"
            },
            "blur": {
              "type": "number",
              "minimum": 0,
              "description": "%config.area.blur%"
            }
          },
          "default": {
            "enabled": false,
            "source": null,
            "opacity": 0.15,
            "size": "cover",
            "position": "center",
            "blur": 0
          }
        },
        "ushiroe.sidebar": {
          "type": "object",
          "scope": "application",
          "order": 5,
          "markdownDescription": "%config.sidebar%",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "%config.area.enabled%"
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "%config.area.source%"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "%config.area.opacity%"
            },
            "size": {
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "auto",
                "stretch",
                "tile"
              ],
              "description": "%config.area.size%"
            },
            "position": {
              "type": "string",
              "description": "%config.area.position%"
            },
            "blur": {
              "type": "number",
              "minimum": 0,
              "description": "%config.area.blur%"
            }
          },
          "default": {
            "enabled": false,
            "source": null,
            "opacity": 0.2,
            "size": "cover",
            "position": "center",
            "blur": 0
          }
        },
        "ushiroe.auxiliaryBar": {
          "type": "object",
          "scope": "application",
          "order": 6,
          "markdownDescription": "%config.auxiliaryBar%",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "%config.area.enabled%"
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "%config.area.source%"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "%config.area.opacity%"
            },
            "size": {
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "auto",
                "stretch",
                "tile"
              ],
              "description": "%config.area.size%"
            },
            "position": {
              "type": "string",
              "description": "%config.area.position%"
            },
            "blur": {
              "type": "number",
              "minimum": 0,
              "description": "%config.area.blur%"
            }
          },
          "default": {
            "enabled": false,
            "source": null,
            "opacity": 0.2,
            "size": "cover",
            "position": "center",
            "blur": 0
          }
        },
        "ushiroe.panel": {
          "type": "object",
          "scope": "application",
          "order": 7,
          "markdownDescription": "%config.panel%",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "%config.area.enabled%"
            },
            "source": {
              "type": [
                "string",
                "null"
              ],
              "description": "%config.area.source%"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "%config.area.opacity%"
            },
            "size": {
              "type": "string",
              "enum": [
                "cover",
                "contain",
                "auto",
                "stretch",
                "tile"
              ],
              "description": "%config.area.size%"
            },
            "position": {
              "type": "string",
              "description": "%config.area.position%"
            },
            "blur": {
              "type": "number",
              "minimum": 0,
              "description": "%config.area.blur%"
            }
          },
          "default": {
            "enabled": false,
            "source": null,
            "opacity": 0.2,
            "size": "cover",
            "position": "center",
            "blur": 0
          }
        },
        "ushiroe.transition": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "scope": "application",
          "order": 8,
          "markdownDescription": "%config.transition%"
        },
        "ushiroe.shuffleInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "scope": "application",
          "order": 9,
          "markdownDescription": "%config.shuffleInterval%"
        },
        "ushiroe.presets": {
          "type": "array",
          "default": [],
          "scope": "application",
          "order": 10,
          "markdownDescription": "%config.presets%",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "fullscreen",
                  "parts"
                ]
              },
              "areas": {
                "type": "object"
              }
            }
          }
        },
        "ushiroe.randomPresetOnStartup": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 11,
          "markdownDescription": "%config.randomPresetOnStartup%"
        },
        "ushiroe.libraryFolder": {
          "type": "string",
          "default": "",
          "scope": "application",
          "order": 12,
          "markdownDescription": "%config.libraryFolder%"
        },
        "ushiroe.patch.hideCorruptWarning": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 20,
          "markdownDescription": "%config.patch.hideCorruptWarning%"
        },
        "ushiroe.patch.autoRepair": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "order": 21,
          "markdownDescription": "%config.patch.autoRepair%"
        }
      }
    }
  }
}
